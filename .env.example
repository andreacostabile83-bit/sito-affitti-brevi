# Configurazione invio email per:
# - il form "Richiedi la tua analisi gratuita" (/valutazione-gratuita,
#   API route app/api/leads/route.ts)
# - il form "Scarica gratis l'ebook" in homepage (API route
#   app/api/guide-download/route.ts)
#
# Entrambi usano Brevo (Sendinblue) tramite la sua API transazionale
# (https://api.brevo.com/v3/smtp/email) per inviare la guida gratuita in
# PDF (assets/guida-gratuita-affitti-brevi.pdf), logica condivisa in
# lib/guide-email.ts.

# Obbligatoria: API key di Brevo (Account > SMTP & API > API Keys).
BREVO_API_KEY=

# Facoltative (hanno un valore di default nel codice):
# Indirizzo che riceve la notifica di ogni nuovo lead da /valutazione-gratuita.
LEAD_NOTIFICATION_EMAIL=info@acdomusaffitti.it

# Mittente tecnico dell'email: deve essere un mittente verificato
# nell'account Brevo (Settings > Mittenti, dominio, IP), altrimenti Brevo
# rifiuta l'invio. Default: il mittente gia' verificato nell'account.
LEAD_FROM_EMAIL=andrea.costabile83@gmail.com
LEAD_FROM_NAME=AC Domus Affitti

# ID (numerico) di una lista contatti Brevo a cui aggiungere chi scarica
# la guida dall'homepage, per poterli ricontattare in futuro (es. newsletter).
# Facoltativa: se non impostata, il contatto viene comunque creato/aggiornato
# in Brevo ma senza essere assegnato a nessuna lista.
BREVO_GUIDE_LIST_ID=
